# ---- PayPal (server-side only; NEVER expose PAYPAL_CLIENT_SECRET to the browser) ----
# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
# PAYPAL_MODE: "sandbox" (real PayPal Sandbox API) or "mock" (offline, clearly-labeled MOCK checkout).
# If unset, the app uses "sandbox" when both credentials are present, otherwise "mock".
PAYPAL_MODE=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the PayPal dashboard, enables signature-verified webhook reconciliation.
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ---- Seller-agent API keys: comma-separated "token:scope|scope" entries ----
# scopes: pricing:read, pricing:recommend, pricing:publish
AGENT_API_KEYS=demo-agent-readonly:pricing:read|pricing:recommend,demo-agent-publisher:pricing:read|pricing:recommend|pricing:publish

# ---- Optional LLM (explanations + policy drafting). Deterministic fallback when unset. ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Storage ----
DATABASE_PATH=./data/pricing-os.db
